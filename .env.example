GITHUB_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
AI_PROVIDER=heuristic
AI_SEARCH_ASSISTANT_PROVIDER=
AI_SEARCH_ASSISTANT_MODEL=
AI_REMEDIATION_AGENT_PROVIDER=
AI_REMEDIATION_AGENT_MODEL=
DATABASE_FILE=
AI_ALLOW_SENSITIVE_MODEL_DATA=
MONITORED_REPOS_FILE=
AI_RUNS_FILE=
API_REQUEST_LOG_FILE=
# Set to true to mark the session cookie Secure behind a TLS-terminating proxy that does not send X-Forwarded-Proto.
SESSION_COOKIE_SECURE=

# Background scheduler: evaluates alert rules and delivers due digests (webhook/Slack) without an open browser tab.
# Off by default. Interval in ms (minimum 30000, default 300000). POST /api/notifications/run still works for external cron.
SCHEDULER_ENABLED=
SCHEDULER_INTERVAL_MS=
# Scheduled repo rescans (needs SCHEDULER_ENABLED and GITHUB_TOKEN): monitored repos whose last scan is older than this are rescanned
# and diffed against the previous scan; new findings become an in-app notification and feed the next digest. Default 86400000 (daily).
REPO_RESCAN_INTERVAL_MS=
